# ---- LLM providers ----
# The model layer is provider-agnostic (see docs/LLM_AND_RAG.md). Pick a default
# provider and per-task overrides; keep model IDs in env, not code.
# LLM_PROVIDER=anthropic          # anthropic | gemini  (default: whichever key is set)
# LLM_MODEL_GENERATE=             # strong model for question authoring + verify
# LLM_MODEL_RENDER=               # cheaper model for prose rendering
# Anthropic key. WITHOUT any provider key the server runs in deterministic mock
# mode (vetted static bank) so the app still works end-to-end.
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# ---- RAG (retrieval) — planned, docs/LLM_AND_RAG.md ----
# Embeddings provider + model, and the pgvector dimension for the chosen model.
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=
# EMBEDDING_DIM=768

# Port the API server listens on (default 8787).
PORT=8787

# ---- Database (Supabase Postgres, Mumbai) ----
# Set DATABASE_URL to use Postgres. Use the Supabase SESSION pooler / direct
# connection (port 5432) for this long-running server — NOT the transaction
# pooler (6543): node-postgres uses prepared statements it doesn't support.
# Leave UNSET to use a local SQLite file. This one variable is the whole switch.
# DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# DATABASE_SSL=disable      # only for a local / non-TLS Postgres
# PG_POOL_MAX=5             # max pooled connections (default 5)
# SQLite file path, used only when DATABASE_URL is unset (default parentproof.db).
DB_PATH=parentproof.db

# Lock the API to your frontend origin(s) in production (comma-separated).
# Unset = open CORS (fine for local dev).
# CORS_ORIGIN=https://your-app.vercel.app

# ---- WhatsApp Business (Meta Cloud API) ----
# WITHOUT these, /api/send-card returns a mock preview (the composed message +
# a wa.me link). WITH them, it delivers via the Cloud API.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Business-initiated messages need a pre-approved template; set its name here.
# (Leave blank to send a plain text message — only valid inside a 24h window.)
WHATSAPP_TEMPLATE=
WHATSAPP_LANG=en
WHATSAPP_API_VERSION=v21.0

# ---- Frontend (Vite, build-time; must be prefixed VITE_) ----
# API origin the web app calls. Empty = same-origin "/api" (dev uses the Vite
# proxy). Point it at your hosted API for a deployed frontend / Capacitor build,
# e.g. VITE_API_BASE=https://api.parentproof.app
VITE_API_BASE=
# WhatsApp Business number for "Continue with WhatsApp" (digits only). Unset =
# the deep link opens the WhatsApp composer instead of a chat with you.
VITE_WA_BUSINESS_NUMBER=
