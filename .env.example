# ---- Backend (server/) ----
# Anthropic API key. WITHOUT it the server runs in deterministic mock mode
# (returns the vetted static bank) so the app still works end-to-end.
# WITH it, /api/generate-test uses claude-opus-4-8 to generate + verify questions.
ANTHROPIC_API_KEY=

# Port the API server listens on (default 8787).
PORT=8787

# ---- Database ----
# Set DATABASE_URL to use Postgres (production, any host: Supabase / Neon /
# Railway / RDS). Leave it UNSET to use a local SQLite file. This one variable
# is the entire SQLite→Postgres switch — nothing else changes.
# DATABASE_URL=postgres://user:pass@host:5432/parentproof
# DATABASE_SSL=disable      # only for a local / non-TLS Postgres
# PG_POOL_MAX=5             # max pooled connections (default 5)
# SQLite file path, used only when DATABASE_URL is unset (default parentproof.db).
DB_PATH=parentproof.db

# Lock the API to your frontend origin(s) in production (comma-separated).
# Unset = open CORS (fine for local dev).
# CORS_ORIGIN=https://your-app.vercel.app

# ---- WhatsApp Business (Meta Cloud API) ----
# WITHOUT these, /api/send-card returns a mock preview (the composed message +
# a wa.me link). WITH them, it delivers via the Cloud API.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Business-initiated messages need a pre-approved template; set its name here.
# (Leave blank to send a plain text message — only valid inside a 24h window.)
WHATSAPP_TEMPLATE=
WHATSAPP_LANG=en
WHATSAPP_API_VERSION=v21.0

# ---- Frontend (Vite, build-time; must be prefixed VITE_) ----
# API origin the web app calls. Empty = same-origin "/api" (dev uses the Vite
# proxy). Point it at your hosted API for a deployed frontend / Capacitor build,
# e.g. VITE_API_BASE=https://api.parentproof.app
VITE_API_BASE=
# WhatsApp Business number for "Continue with WhatsApp" (digits only). Unset =
# the deep link opens the WhatsApp composer instead of a chat with you.
VITE_WA_BUSINESS_NUMBER=
